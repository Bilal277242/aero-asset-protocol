# Copy to .env.local. Nothing here is secret — every address is public and verified —
# but an RPC URL with an embedded API key should not be committed.

NEXT_PUBLIC_AAP_CHAIN_ID=11155111
NEXT_PUBLIC_AAP_RPC_URL=https://sepolia.infura.io/v3/<key>

# The ONLY protocol address that comes from config. Every module is resolved through
# it at runtime, so this is the single root of trust.
NEXT_PUBLIC_AAP_ADDRESS_REGISTRY=0xc9cf5998604A65e2C115476b7D165CB7A68e6224

# Not a protocol module — an allowlist entry in FeeManager. Validated at boot.
NEXT_PUBLIC_AAP_SETTLEMENT_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
