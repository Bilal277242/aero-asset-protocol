# ---------------------------------------------------------------------------
# AeroAsset web interface — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
# Nothing here is secret except the keyed RPC URL. Every contract address is
# public and verified on Etherscan.
# ---------------------------------------------------------------------------

# Chain. Must have a committed deployment in src/lib/contracts/generated/addresses.ts.
NEXT_PUBLIC_AAP_CHAIN_ID=11155111

# --- RPC endpoints ---------------------------------------------------------
# Browser-visible. Public and rate-limited by design; it ships in the bundle.
NEXT_PUBLIC_AAP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Server-only, and deliberately WITHOUT the NEXT_PUBLIC_ prefix so Next.js will
# not inline it into client code. Used by server components for public reads.
# Falls back to the public endpoint when unset.
AAP_RPC_URL=

# --- Protocol --------------------------------------------------------------
# The ONLY contract address that comes from configuration. Every module is
# resolved through it at runtime, so this is the single root of trust.
NEXT_PUBLIC_AAP_ADDRESS_REGISTRY=0xc9cf5998604A65e2C115476b7D165CB7A68e6224

# Not a protocol module — an allowlist entry in FeeManager, validated at boot.
NEXT_PUBLIC_AAP_SETTLEMENT_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
