# ---------------------------------------------------------------------------
# AeroAsset Protocol - environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
# Nothing in this file is read by `forge test`; it is only used by script/ runs.
# ---------------------------------------------------------------------------

# --- RPC endpoints ---------------------------------------------------------
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/<key>"
MAINNET_RPC_URL=""
BASE_SEPOLIA_RPC_URL=""
BASE_RPC_URL=""

# --- Block explorer verification -------------------------------------------
ETHERSCAN_API_KEY=""
BASESCAN_API_KEY=""

# --- Deployer -------------------------------------------------------------
# Prefer a hardware wallet or keystore over a raw key:
#   cast wallet import deployer --interactive
#   forge script ... --account deployer
# PRIVATE_KEY is supported only for throwaway testnet keys.
PRIVATE_KEY=""
DEPLOYER_ACCOUNT="deployer"

# --- Protocol configuration (consumed by script/*.s.sol) -------------------
# Timelock proposer. This is the account that can queue every privileged action,
# so it MUST be a multisig on mainnet. It is NOT granted any protocol role
# directly — it proposes, the timelock executes.
PROTOCOL_ADMIN=""
# Timelock delay in seconds. Production requires >= 48h (172800); a shorter value
# is only appropriate on a testnet, where waiting two days between configuration
# steps helps nobody.
TIMELOCK_MIN_DELAY="172800"

# Address that receives protocol fees.
FEE_TREASURY=""
# Settlement token for the escrow layer. Sepolia USDC shown; verify before use.
SETTLEMENT_TOKEN="0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238"
# Marketplace fee in basis points. Hard-capped at 1000 (10%) by FeeManager.
MARKETPLACE_FEE_BPS="200"

# --- Operational role holders ----------------------------------------------
# Verifies organizations and assets (ORG_VERIFIER_ROLE + ASSET_VERIFIER_ROLE).
ORG_VERIFIER=""
# Issues and revokes aviation credentials (CREDENTIAL_ISSUER_ROLE).
CREDENTIAL_ISSUER=""
# Resolves escrow disputes (ARBITRATOR_ROLE).
DISPUTE_ARBITRATOR=""
# Emergency pause (PAUSER_ROLE). MUST be on keys held separately from
# PROTOCOL_ADMIN — Verify.s.sol asserts the two are not the same account.
PROTOCOL_PAUSER=""
